[Desktop Entry]
Name=Arrow Browser
Comment=Modern, Ultra-Fast, Multi-Tab, and Privacy-First Web Browser engineered for Linux (Fedora & Ubuntu)
Exec=arrow-browser %U
Icon=arrow-browser
Terminal=false
Type=Application
Categories=Network;WebBrowser;
StartupWMClass=arrow-browser
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
